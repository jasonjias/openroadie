    def Scope "Materials" {
        def Material "colormap" {
            token outputs:surface.connect = </Vehicle/Materials/colormap/surface.outputs:surface>
            def Shader "surface" {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:roughness = 0.7
                float inputs:metallic = 0
                color3f inputs:diffuseColor.connect = </Vehicle/Materials/colormap/texture.outputs:rgb>
                token outputs:surface
            }
            def Shader "stReader" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "texture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @kenney-train-colormap.png@
                float2 inputs:st.connect = </Vehicle/Materials/colormap/stReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}
